# Railway injects DATABASE_URL when a Postgres service is attached.
DATABASE_URL=postgres://user:pass@localhost:5432/skym

# Public origin, used to build the pairing URL shown in the terminal.
# Set this to the Railway domain — without it the URL is guessed from the
# request host, which is wrong behind some proxies.
PUBLIC_URL=https://skym.up.railway.app

# OAuth. Callbacks must be registered as <PUBLIC_URL>/auth/<provider>/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Where uploaded blobs are written — figures today, whatever else later.
# MUST point at a mounted Railway volume: the container filesystem is
# ephemeral and uploads vanish on redeploy. Attach a volume in Railway and
# set its mount path to match this.
BLOB_DIR=/data/blobs

# Bytes of blob storage each plan grants, across every chart a user owns.
# Uploads past the limit are refused (507); nothing already stored is evicted.
# A user's plan lives on users.plan; users.storage_limit_bytes overrides these
# for one account without inventing a tier for them.
STORAGE_QUOTA_FREE=52428800
STORAGE_QUOTA_PRO=1073741824

PORT=8080
