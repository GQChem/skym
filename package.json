{
  "name": "skym-flow",
  "version": "0.1.0",
  "description": "MCP server that maintains a live project flowchart and renders it in an auto-refreshing local viewer.",
  "type": "module",
  "bin": {
    "skym-flow": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./ops": { "types": "./dist/ops.d.ts", "import": "./dist/ops.js" },
    "./store": { "types": "./dist/store.d.ts", "import": "./dist/store.js" },
    "./validate": { "types": "./dist/validate.d.ts", "import": "./dist/validate.js" },
    "./vocab": { "types": "./dist/vocab.d.ts", "import": "./dist/vocab.js" },
    "./theme": { "types": "./dist/theme.d.ts", "import": "./dist/theme.js" },
    "./layout": { "types": "./dist/layout.d.ts", "import": "./dist/layout.js" },
    "./render": { "types": "./dist/render.d.ts", "import": "./dist/render.js" },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "public",
    "scripts"
  ],
  "workspaces": [
    "service"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-client.mjs",
    "postbuild": "npm run build --workspace service --if-present",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "npm run build && node --test \"test/*.test.js\"",
    "test:watch": "node --test --watch \"test/*.test.js\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
