{
  "name": "skym-flow",
  "version": "0.1.0",
  "description": "MCP server that maintains a live project flowchart and renders it in an auto-refreshing local viewer.",
  "type": "module",
  "bin": {
    "skym-flow": "dist/index.js"
  },
  "files": [
    "dist",
    "public"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "tsc && node --test \"test/*.test.js\"",
    "test:watch": "node --test --watch \"test/*.test.js\""
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
